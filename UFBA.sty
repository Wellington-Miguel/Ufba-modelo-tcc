%%
%% Customizações do abnTeX2 para a Universidade Federal da Bahia (UFBA)
%% Em conformidade com o Manual de Estilo Acadêmico da EDUFBA (6ª edição, 2019)
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{UFBA}[2026/10/22 v2.0 Customizacao abnTeX2 para UFBA]

\RequirePackage{graphicx}
\RequirePackage{placeins}

% ---
% DADOS INSTITUCIONAIS E ACADÊMICOS
% ---

% Subtítulo
\providecommand{\imprimirsubtitulo}{}
\newcommand{\subtitulo}[1]{\renewcommand{\imprimirsubtitulo}{#1}}

% Unidade de Ensino (Faculdade, Instituto, Escola)
\providecommand{\imprimirfaculdade}{}
\newcommand{\faculdade}[1]{\renewcommand{\imprimirfaculdade}{#1}}

% Programa / Colegiado / Departamento
\providecommand{\imprimirprograma}{}
\newcommand{\programa}[1]{\renewcommand{\imprimirprograma}{#1}}

% Curso
\providecommand{\imprimircurso}{}
\newcommand{\curso}[1]{\renewcommand{\imprimircurso}{#1}}

% Orientadora e Coorientadora
\newcommand{\orientadoraname}{Orientadora:}
\newcommand{\coorientadoraname}{Coorientadora:}
\newcommand{\professorname}{Professor:}

\providecommand{\imprimirorientadoraRotulo}{}
\providecommand{\imprimirorientadora}{}
\newcommand{\orientadora}[2][\orientadoraname]%
  {\renewcommand{\imprimirorientadoraRotulo}{#1}%
   \renewcommand{\imprimirorientadora}{#2}}

\providecommand{\imprimircoorientadoraRotulo}{}
\providecommand{\imprimircoorientadora}{}
\newcommand{\coorientadora}[2][\coorientadoraname]%
  {\renewcommand{\imprimircoorientadoraRotulo}{#1}%
   \renewcommand{\imprimircoorientadora}{#2}}

\providecommand{\imprimirprofessorRotulo}{}
\providecommand{\imprimirprofessor}{}
\newcommand{\professor}[2][\professorname]%
  {\renewcommand{\imprimirprofessorRotulo}{#1}%
   \renewcommand{\imprimirprofessor}{#2}}

% ---
% CAPA (Manual EDUFBA 6ª ed., p. 41 e Figura 1, p. 44)
% ---
\renewcommand{\imprimircapa}{%
  \begin{capa}%
    \begin{center}
      \vspace*{0.5cm}
      % Brasão da UFBA
      \includegraphics[width=1.6cm]{logo_ufba.png}
      \vspace{0.4cm}

      % Nome da Instituição (corpo 16, negrito, maiúscula)
      {\fontsize{16}{18}\selectfont\bfseries\MakeUppercase{\imprimirinstituicao}\par}
      \vspace{0.2cm}

      % Nome da Unidade de Ensino (corpo 14, negrito, maiúscula)
      \abntex@ifnotempty{\imprimirfaculdade}{%
        {\fontsize{14}{16}\selectfont\bfseries\MakeUppercase{\imprimirfaculdade}\par}%
        \vspace{0.2cm}%
      }

      % Nome do Programa / Departamento / Colegiado (corpo 12, negrito, maiúscula)
      \abntex@ifnotempty{\imprimirprograma}{%
        {\fontsize{12}{14}\selectfont\bfseries\MakeUppercase{\imprimirprograma}\par}%
      }

      \vspace{\fill}

      % Nome do autor (corpo 14, negrito, maiúscula)
      {\fontsize{14}{16}\selectfont\bfseries\MakeUppercase{\imprimirautor}\par}

      \vspace{\fill}

      % Título (corpo 16, negrito, maiúscula) e Subtítulo (corpo 14)
      {\fontsize{16}{19}\selectfont\bfseries\MakeUppercase{\imprimirtitulo}%
      \abntex@ifnotempty{\imprimirsubtitulo}{%
        {: \fontsize{14}{17}\selectfont\MakeUppercase{\imprimirsubtitulo}}%
      }\par}

      \vspace{\fill}

      % Cidade (corpo 14, sem negrito)
      {\fontsize{14}{16}\selectfont\imprimirlocal\par}
      \vspace{0.1cm}
      % Ano de depósito (corpo 14, sem negrito)
      {\fontsize{14}{16}\selectfont\imprimirdata\par}
      \vspace*{0.5cm}
    \end{center}
  \end{capa}
}

% ---
% FOLHA DE ROSTO (Manual EDUFBA 6ª ed., p. 42-43 e Figuras 3-5)
% ---
\makeatletter
\renewcommand{\folhaderostocontent}{%
  \begin{center}
    \vspace*{0.5cm}
    % Nome do autor (corpo 14, negrito, maiúscula)
    {\fontsize{14}{16}\selectfont\bfseries\MakeUppercase{\imprimirautor}\par}

    \vspace{8.5cm}

    % Título a ~9cm da margem superior
    {\fontsize{16}{19}\selectfont\bfseries\MakeUppercase{\imprimirtitulo}%
    \abntex@ifnotempty{\imprimirsubtitulo}{%
      {: \fontsize{14}{17}\selectfont\MakeUppercase{\imprimirsubtitulo}}%
    }\par}

    \vspace{\fill}

    % Preâmbulo com recuo à direita (espaço simples, corpo menor/12)
    \abntex@ifnotempty{\imprimirpreambulo}{%
      \begin{flushright}
        \begin{minipage}{0.55\textwidth}
          \SingleSpacing
          \fontsize{11}{13}\selectfont
          \imprimirpreambulo\par
          \vspace{0.5cm}

          \abntex@ifnotempty{\imprimirprofessor}{%
            {\imprimirprofessorRotulo~\imprimirprofessor\par}%
          }
          \abntex@ifnotempty{\imprimirorientador}{%
            {\imprimirorientadorRotulo~\imprimirorientador\par}%
          }
          \abntex@ifnotempty{\imprimirorientadora}{%
            {\imprimirorientadoraRotulo~\imprimirorientadora\par}%
          }
          \abntex@ifnotempty{\imprimircoorientador}{%
            {\imprimircoorientadorRotulo~\imprimircoorientador\par}%
          }
          \abntex@ifnotempty{\imprimircoorientadora}{%
            {\imprimircoorientadoraRotulo~\imprimircoorientadora\par}%
          }
        \end{minipage}
      \end{flushright}
    }

    \vspace{\fill}

    % Cidade e Ano
    {\fontsize{14}{16}\selectfont\imprimirlocal\par}
    \vspace{0.1cm}
    {\fontsize{14}{16}\selectfont\imprimirdata\par}
    \vspace*{0.5cm}
  \end{center}
}

% ---
% RESUMO E ABSTRACT (Manual EDUFBA 6ª ed., p. 64-65)
% A referência da monografia antecede a palavra RESUMO/ABSTRACT centralizada no topo
% ---
\renewenvironment{resumo}[1][\resumoname]{%
  \clearpage
  \PRIVATEbookmarkthis{#1}%
}{%
  \PRIVATEclearpageifneeded
}
\makeatother

% ---
% CABEÇALHO E NUMERAÇÃO DE PÁGINAS (Manual EDUFBA 6ª ed., p. 75-76 / ABNT NBR 14724)
% Apenas número da página no canto superior direito, sem linhas ou títulos de capítulos
% ---
\makepagestyle{abntheadings}
\makeevenhead{abntheadings}{}{}{\thepage}
\makeoddhead{abntheadings}{}{}{\thepage}
\makeheadrule{abntheadings}{\textwidth}{0pt}
\makeevenfoot{abntheadings}{}{}{}
\makeoddfoot{abntheadings}{}{}{}

\makepagestyle{abntchapfirst}
\makeevenhead{abntchapfirst}{}{}{\thepage}
\makeoddhead{abntchapfirst}{}{}{\thepage}
\makeheadrule{abntchapfirst}{\textwidth}{0pt}
\makeevenfoot{abntchapfirst}{}{}{}
\makeoddfoot{abntchapfirst}{}{}{}

\makepagestyle{ufbapagestyle}
\makeevenhead{ufbapagestyle}{}{}{\thepage}
\makeoddhead{ufbapagestyle}{}{}{\thepage}
\makeheadrule{ufbapagestyle}{\textwidth}{0pt}
\makeevenfoot{ufbapagestyle}{}{}{}
\makeoddfoot{ufbapagestyle}{}{}{}

% ---
% FORMATAÇÃO DE TÍTULOS DE SEÇÕES NO TEXTO (Manual EDUFBA 6ª ed., p. 89-90)
% Seção Primária: Maiúsculas, Negrito
% Seção Secundária: Maiúsculas, Redondo (Sem Negrito)
% Seção Terciária: Minúsculas com inicial maiúscula, Negrito
% Seção Quaternária: Minúsculas com inicial maiúscula, Redondo (Sem Negrito)
% Seção Quinária: Minúsculas com inicial maiúscula, Itálico
% ---
\renewcommand{\ABNTEXchapterfont}{\bfseries}
\renewcommand{\ABNTEXsectionfont}{\normalfont\mdseries}
\renewcommand{\ABNTEXsubsectionfont}{\bfseries}
\renewcommand{\ABNTEXsubsubsectionfont}{\normalfont\mdseries}
\renewcommand{\ABNTEXsubsubsubsectionfont}{\itshape}

\renewcommand{\ABNTEXchapterfontsize}{\fontsize{12}{14}\selectfont\bfseries}
\renewcommand{\ABNTEXsectionfontsize}{\fontsize{12}{14}\selectfont\normalfont\mdseries}
\renewcommand{\ABNTEXsubsectionfontsize}{\fontsize{12}{14}\selectfont\bfseries}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\fontsize{12}{14}\selectfont\normalfont\mdseries}
\renewcommand{\ABNTEXsubsubsubsectionfontsize}{\fontsize{12}{14}\selectfont\itshape}

% ---
% FORMATAÇÃO DE TÍTULOS NO SUMÁRIO (Manual EDUFBA 6ª ed., p. 69 e 89)
% Nível 1 (\chapter): CAIXA ALTA e Negrito
% Nível 2 (\section): CAIXA ALTA e Sem Negrito
% Nível 3 (\subsection): Title Case e Com Negrito
% Nível 4 (\subsubsection): Title Case e Sem Negrito
% ---
\renewcommand{\cftchapterfont}{\bfseries}
\renewcommand{\cftchapterpagefont}{\cftchapterfont}

\renewcommand{\cftsectionfont}{\normalfont\mdseries}
\renewcommand{\cftsectionpagefont}{\cftsectionfont}

\renewcommand{\cftsubsectionfont}{\bfseries}
\renewcommand{\cftsubsectionpagefont}{\cftsubsectionfont}

\renewcommand{\cftsubsubsectionfont}{\normalfont\mdseries}
\renewcommand{\cftsubsubsectionpagefont}{\cftsubsubsectionfont}

\renewcommand{\cftparagraphfont}{\normalfont\mdseries}
\renewcommand{\cftparagraphpagefont}{\cftparagraphfont}

% ---
% TÍTULO DAS REFERÊNCIAS (Manual EDUFBA 6ª ed., p. 77 / ABNT NBR 6023)
% ---
\renewcommand{\bibname}{REFER\^ENCIAS}

% ---
% DESATIVAÇÃO DAS ASPAS ATIVAS DO BABEL (Evita erro de Argument of \language@active@arg")
% ---
\AtBeginDocument{%
  \renewcommand{\bibname}{REFER\^ENCIAS}%
  \addto\captionsbrazilian{\renewcommand{\bibname}{REFER\^ENCIAS}}%
  \addto\extrasbrazilian{\shorthandoff{"}}%
  \addto\extrasportuges{\shorthandoff{"}}%
  \shorthandoff{"}%
}

